{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/api/auth/linkedin", "destination": "/api/linkedin" },
    { "source": "/api/auth/linkedin/callback", "destination": "/api/linkedin" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
